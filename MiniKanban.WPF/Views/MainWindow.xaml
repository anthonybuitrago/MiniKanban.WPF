<Window x:Class="MiniKanban.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiniKanban.WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid Margin=" 15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F5F7" Padding="15" CornerRadius="8" Margin="0,0,0,15">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                    <TextBlock Text="Título:" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NuevoTitulo, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                    <TextBlock Text="Descripción:" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NuevaDescripcion}" Padding="5"/>
                </StackPanel>

                <Button Grid.Row="0" Grid.Column="2" Content="➕ Crear Tarea"
                        Command="{Binding CrearTareaCommand}"
                        Margin="5,20,5,5" Padding="15,6" Background="#0052CC" Foreground="White" FontWeight="Bold"/>

            </Grid>


        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#EBECF0" CornerRadius="8" Padding="10" Margin="5">

                <DockPanel>

                    <TextBlock DockPanel.Dock="Top" Text="📋 Por Hacer" FontWeight="Bold" FontSize="15" Margin="0,0,0,10" Foreground="#172B4D"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TareasPorHacer}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Titulo}" FontWeight="Bold" FontSize="14" Foreground="#172B4D"/>
                                            <TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap" Margin="0,4,0,8" Foreground="#5E6C84"/>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Left" Content="🗑️" Command="{Binding DataContext.EliminarTareaCommand,RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand"/>

                                                <Button DockPanel.Dock="Right" Content="Avanzar ➡️" Command="{Binding DataContext.AvanzarTareaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Background="#0052CC" Foreground="White" Padding="8,3" BorderThickness="0" Cursor="Hand"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </DockPanel>
                
            </Border>

            <!-- COLUMNA 1: EN PROGRESO -->
            <Border Grid.Column="1" Background="#EBECF0" CornerRadius="8" Padding="10" Margin="5">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="⏳ En Progreso" FontWeight="Bold" FontSize="15" Margin="0,0,0,10" Foreground="#172B4D"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TareasEnProgreso}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Titulo}" FontWeight="Bold" FontSize="14" Foreground="#172B4D"/>
                                            <TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap" Margin="0,4,0,8" Foreground="#5E6C84"/>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Left" Content="⬅️" 
                                            Command="{Binding DataContext.RetrocederTareaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Margin="0,0,5,0" Padding="5,2" Cursor="Hand"/>
                                                <Button DockPanel.Dock="Left" Content="🗑️" 
                                            Command="{Binding DataContext.EliminarTareaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                                <Button DockPanel.Dock="Right" Content="Completar ➡️" 
                                            Command="{Binding DataContext.AvanzarTareaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Background="#00875A" Foreground="White" Padding="8,3" BorderThickness="0" Cursor="Hand"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- COLUMNA 2: HECHAS -->
            <Border Grid.Column="2" Background="#EBECF0" CornerRadius="8" Padding="10" Margin="5">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="✅ Hechas" FontWeight="Bold" FontSize="15" Margin="0,0,0,10" Foreground="#172B4D"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TareasHechas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Titulo}" FontWeight="Bold" FontSize="14" Foreground="#172B4D" TextDecorations="Strikethrough"/>
                                            <TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap" Margin="0,4,0,8" Foreground="#5E6C84"/>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Left" Content="⬅️ Reabrir" 
                                            Command="{Binding DataContext.RetrocederTareaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Padding="6,2" Cursor="Hand"/>
                                                <Button DockPanel.Dock="Right" Content="🗑️" 
                                            Command="{Binding DataContext.EliminarTareaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

        </Grid>
        
    </Grid>

</Window>